# Secrets — never commit API keys
.env
*.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Per-event bulk data: raw acquisitions and clean tapes are too large for
# GitHub (up to 1GB) and fully regenerable via arbpipe.fetch.* + arbpipe.clean.*.
# Everything else in events/ IS versioned: event.json, results/, reference/.
events/*/raw/
events/*/clean/
*.log
*.checkpoint.json

# Delivery bundles (large, derived — regenerate from scripts, don't version)
delivery*/
*.zip
*.gz

# OS / editor
.DS_Store
.ipynb_checkpoints/

# The *_merged_* alias is BYTE-IDENTICAL to merged_sorted_for_arb.csv (verified
# on all four events that have one, 2026-11-08) and merge_for_arb.py regenerates
# it in seconds. Versioning it would write a second copy of the same ~82MB into
# history, which git never gives back. The file is still PRODUCED on disk — it is
# one of the named deliverables — it is just not versioned twice.
events/*/results/kalshi_poly_merged_sorted_for_arb.csv

# Presidential sorted tapes ALSO exceed GitHub's 100MB per-file cap; all are
# regenerable via merge_for_arb.py.
events/presidential-*/results/merged_sorted_for_arb.csv
events/presidential-*/results/poly_sorted_for_arb.csv
events/presidential-*/results/kalshi_sorted_for_arb.csv

# arbpipe.verify.reference_matcher writes its reproduction BESIDE the reference
# files it is checking against. The reference files ARE versioned (they are the
# provenance for every Net here); the reproduction is derived, so it is not.
events/*/reference/reproduced_*.csv
